# 测试环境配置
# 指向 docker-compose.test.yml 中的测试基础设施

APP_NAME=Maneki API Test
APP_VERSION=test
DEBUG=true
PORT=18080

SECRET_KEY=test-secret-key-do-not-use-in-production

# 测试数据库（端口 5433，与开发环境隔离）
DB_HOST=localhost
DB_PORT=5433
DB_USER=stock
DB_PASSWORD=stock123
DB_NAME=stock_test
DB_SSLMODE=disable

# 测试 Redis（端口 6380，与开发环境隔离）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=1

# 禁用外部依赖
SMS_MODE=mock
TUSHARE_ENABLED=false
LLM_PROVIDER=mock

# 内部服务通信
DATA_SERVICE_URL=http://localhost:8001

# CORS
CORS_ORIGINS=http://localhost:5173
