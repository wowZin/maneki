# 应用配置
APP_NAME=Maneki API
APP_VERSION=1.0.0
DEBUG=true
PORT=8080

# 安全密钥（生产环境必须设置强密钥）
SECRET_KEY=your-secret-key-change-in-production

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=stock
DB_PASSWORD=stock123
DB_NAME=stock_analysis
DB_SSLMODE=disable

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_ACCESS_EXPIRE=2h
JWT_REFRESH_EXPIRE=168h

# 数据源配置
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_ENABLED=false
# 数据服务URL（原 Akshare 代理）
DATA_SERVICE_URL=http://localhost:8001
DATA_SOURCE_STRATEGY=tiered

# 微信配置
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# LLM配置
LLM_PROVIDER=aliyun
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
LLM_MODEL_ADVANCED=qwen-plus

# VIP/返佣配置
REBATE_ENABLED=true
REBATE_AMOUNT=10.0
REBATE_MIN_VIP_DAYS=30
REBATE_SETTLEMENT_DAYS=7
REBATE_MAX_PER_MONTH=1000.0

# 短信/号码认证配置
SMS_MODE=mock
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_PNS_APP_KEY=

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
