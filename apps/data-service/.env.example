# Data Service 配置

# 服务配置
APP_NAME=Maneki Data Service
APP_VERSION=1.0.0
PORT=8001

# Tushare Pro 配置（可选）
# 配置后将优先使用 Tushare Pro 获取数据
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_ENABLED=false

# 数据源策略
# auto: 自动选择（优先 Tushare，如果配置了token）
# tushare: 强制使用 Tushare
# akshare: 强制使用 Akshare
DATA_SOURCE_STRATEGY=auto

# 缓存配置
CACHE_TTL=300
